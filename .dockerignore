# ─── Root .dockerignore ──────────────────────────────────────────────────────
# Applied when building from the project root (e.g. for CI/CD).
# Individual backend/ and frontend/ .dockerignore files take precedence
# for context-scoped builds.

backend/venv/
frontend/node_modules/
frontend/dist/
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.env
*.log
.git/
.gitignore
PROJECT_PROGRESS_REPORT.md

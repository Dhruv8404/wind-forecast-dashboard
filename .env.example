# ─── Wind Forecast Intelligence Dashboard Configuration ────────────────────────
# Copy this file to .env and adjust variables as needed for your environment.
# Never commit real credentials or secrets to version control.

# ── Backend Configuration ──
ENV=development                                    # development | production
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (comma-separated origins or * for wildcard)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Elexon BMRS API Endpoint (default: official Elexon Insights Solution base URL)
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
ELEXON_TIMEOUT=20.0

# Day-Ahead Decision Cutoff Hour (UTC on D-1, default: 10 for 10:00 UTC D-1)
DEFAULT_CUTOFF_HOUR=10

# Synthetic Data Fallback (set to false in strict production environments to reject mock fallbacks)
ALLOW_SYNTHETIC_FALLBACK=true

# ── Frontend Configuration ──
# Base URL for the backend API.
# - Leave empty ('') for local Vite dev (uses /api dev proxy) or Docker Nginx reverse proxy.
# - Set to full backend URL (e.g. https://api.yourdomain.com) when deploying frontend to Vercel/Cloud.
VITE_API_BASE_URL=
